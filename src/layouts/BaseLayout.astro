---
export interface Props {
  title: string;
  description?: string;
  /** Canonical path, e.g. "/2014/05/12/foo/". Defaults to current URL path. */
  path?: string;
  ogType?: 'website' | 'article';
  /** Site-absolute path or URL for the social preview image. */
  ogImage?: string;
}

const SITE_TITLE = 'Tom Ron';
const SITE_DESCRIPTION =
  'Tom Ron — data scientist. Notes on data, Python, machine learning, and things worth reading.';

const {
  title,
  description = SITE_DESCRIPTION,
  path = Astro.url.pathname,
  ogType = 'website',
  ogImage,
} = Astro.props;

const canonical = new URL(path, Astro.site).toString();
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
const fullTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;
const year = new Date().getFullYear();

// GoatCounter analytics: set PUBLIC_GOATCOUNTER to your endpoint, e.g.
// "https://tomron.goatcounter.com/count". Left unset -> no script, no tracking.
const goatcounter = import.meta.env.PUBLIC_GOATCOUNTER;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta
      name="twitter:card"
      content={ogImageUrl ? 'summary_large_image' : 'summary'}
    />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('/rss.xml', Astro.site).toString()}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      goatcounter && (
        <script
          is:inline
          data-goatcounter={goatcounter}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }

    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>

    <style is:global>
      :root {
        --bg: #ffffff;
        --fg: #1a1a1a;
        --muted: #5c5c5c;
        --accent: #1d4ed8;
        --border: #e5e5e5;
        --code-bg: #f4f4f5;
        --max: 42rem;
        --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica,
          Arial, sans-serif;
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      /* Dark palette: applied when the OS asks for it AND the user hasn't
         forced light, or when the user explicitly picks dark. */
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #101114;
          --fg: #e8e8e8;
          --muted: #9a9a9a;
          --accent: #7aa2ff;
          --border: #2a2b2f;
          --code-bg: #1b1c20;
        }
      }
      :root[data-theme='dark'] {
        --bg: #101114;
        --fg: #e8e8e8;
        --muted: #9a9a9a;
        --accent: #7aa2ff;
        --border: #2a2b2f;
        --code-bg: #1b1c20;
      }
      * {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font);
        font-size: 1.05rem;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      img {
        max-width: 100%;
        height: auto;
        border-radius: 6px;
      }
      figure {
        margin: 1.5rem 0;
      }
      figcaption {
        color: var(--muted);
        font-size: 0.9rem;
        text-align: center;
        margin-top: 0.4rem;
      }
      pre {
        background: var(--code-bg);
        padding: 1rem;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 0.9rem;
      }
      code {
        font-family: var(--mono);
        background: var(--code-bg);
        padding: 0.15em 0.35em;
        border-radius: 4px;
        font-size: 0.9em;
      }
      pre code {
        background: none;
        padding: 0;
      }
      blockquote {
        margin: 1.5rem 0;
        padding-left: 1rem;
        border-left: 3px solid var(--border);
        color: var(--muted);
      }
      table {
        border-collapse: collapse;
        width: 100%;
        overflow-x: auto;
        display: block;
      }
      th,
      td {
        border: 1px solid var(--border);
        padding: 0.5rem 0.75rem;
        text-align: left;
      }
      hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2rem 0;
      }
      .wrap {
        max-width: var(--max);
        margin: 0 auto;
        padding: 0 1.25rem;
      }
      .site-header {
        border-bottom: 1px solid var(--border);
      }
      .site-header .wrap {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 1.1rem;
        padding-bottom: 1.1rem;
      }
      .site-header .brand {
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--fg);
      }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        font-size: 0.98rem;
      }
      .site-nav a {
        color: var(--muted);
      }
      .site-nav a[aria-current='page'] {
        color: var(--fg);
        font-weight: 600;
      }
      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.25rem;
        margin: -0.25rem 0;
        background: none;
        border: 0;
        color: var(--muted);
        cursor: pointer;
        border-radius: 6px;
      }
      .theme-toggle:hover {
        color: var(--fg);
      }
      /* JS sets .is-dark on the button to reflect the effective theme;
         we show the icon for the mode you'd switch INTO. */
      .theme-toggle .icon-moon {
        display: none;
      }
      .theme-toggle.is-dark .icon-sun {
        display: none;
      }
      .theme-toggle.is-dark .icon-moon {
        display: inline;
      }
      main.wrap {
        padding-top: 2.5rem;
        padding-bottom: 3rem;
      }
      .site-footer {
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.9rem;
      }
      .site-footer .wrap {
        padding-top: 1.5rem;
        padding-bottom: 2rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1.25rem;
        justify-content: space-between;
      }
      .site-footer .social {
        display: flex;
        gap: 1rem;
      }
      .site-footer .social a {
        color: var(--muted);
        display: inline-flex;
      }
      .site-footer .social a:hover {
        color: var(--fg);
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Tom Ron</a>
        <nav class="site-nav">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
          <a
            href="/blog/"
            aria-current={path.startsWith('/blog') ? 'page' : undefined}
            >Blog</a
          >
          <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}
            >About</a
          >
          <button
            id="theme-toggle"
            type="button"
            class="theme-toggle"
            aria-label="Toggle color theme"
            title="Toggle light / dark / system"
          >
            <svg
              class="icon-sun"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              aria-hidden="true"
            >
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                d="M12 4V2m0 20v-2m8-8h2M2 12h2m13.66-5.66 1.41-1.41M4.93 19.07l1.41-1.41m0-11.32L4.93 4.93m14.14 14.14-1.41-1.41"
              ></path>
              <circle
                cx="12"
                cy="12"
                r="4.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"></circle>
            </svg>
            <svg
              class="icon-moon"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              aria-hidden="true"
            >
              <path
                fill="currentColor"
                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
              ></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {year} Tom Ron · <a href="/rss.xml">RSS</a></span>
        <nav class="social" aria-label="Social links">
          <a
            href="https://www.linkedin.com/in/rontom/"
            aria-label="LinkedIn"
            rel="me noopener"
            target="_blank"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path
                fill="currentColor"
                d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"
              ></path>
            </svg>
          </a>
          <a
            href="https://github.com/tomron"
            aria-label="GitHub"
            rel="me noopener"
            target="_blank"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8 0 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"
              ></path>
            </svg>
          </a>
          <a
            href="https://x.com/tomron696"
            aria-label="X (Twitter)"
            rel="me noopener"
            target="_blank"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path
                fill="currentColor"
                d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.22-6.82-5.97 6.82H1.66l7.73-8.83L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.01 4.13H5.05l12.03 15.64z"
              ></path>
            </svg>
          </a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');

        function stored() {
          try {
            return localStorage.getItem('theme');
          } catch (e) {
            return null;
          }
        }
        // effective theme = explicit choice, else the OS preference
        function effective() {
          var s = stored();
          if (s === 'light' || s === 'dark') return s;
          return mq.matches ? 'dark' : 'light';
        }
        function sync() {
          btn.classList.toggle('is-dark', effective() === 'dark');
        }
        function apply(theme) {
          try {
            if (theme === 'light' || theme === 'dark') {
              localStorage.setItem('theme', theme);
              root.setAttribute('data-theme', theme);
            } else {
              localStorage.removeItem('theme');
              root.removeAttribute('data-theme');
            }
          } catch (e) {}
          sync();
        }

        // click cycles: system -> light -> dark -> system
        btn.addEventListener('click', function () {
          var s = stored();
          if (s === 'light') apply('dark');
          else if (s === 'dark') apply(null);
          else apply('light');
        });

        // follow the OS while in "system" mode
        mq.addEventListener('change', function () {
          if (!stored()) sync();
        });

        sync();
      })();
    </script>
  </body>
</html>
