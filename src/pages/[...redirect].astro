---
// Static "301-style" redirect pages for routes that can't be preserved 1:1.
// One entry in src/data/redirects.json = one redirect page.
import RedirectPage from '../layouts/RedirectPage.astro';
import redirects from '../data/redirects.json';

export function getStaticPaths() {
  return redirects.map(({ from, to }) => ({
    params: { redirect: from.replace(/^\/+|\/+$/g, '') },
    props: { to },
  }));
}

const { to } = Astro.props;
---

<RedirectPage to={to} />
