---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getPublishedPosts,
  tagSlug,
  decodeLabel,
  postDescription,
  readingMinutes,
  adjacentPosts,
  relatedPosts,
} from '../lib/posts';
import { highlightCodeBlocks } from '../lib/highlight';
import { getMentions } from '../lib/webmentions';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    // permalink is "/2014/05/12/slug/" -> slug param "2014/05/12/slug"
    params: { slug: post.data.permalink.replace(/^\/+|\/+$/g, '') },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;

const bodyHtml = await highlightCodeBlocks(post.body ?? '');

const dateLong = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const description = postDescription(post);
const minutes = readingMinutes(post);
const { newer, older } = adjacentPosts(posts, post);
const related = relatedPosts(posts, post, 4, [newer, older]);

const mentions = await getMentions(post.data.permalink);
const reactions = mentions.filter(
  (m) => m.type === 'like' || m.type === 'repost',
);
const responses = mentions.filter(
  (m) => m.type === 'reply' || m.type === 'mention',
);

const shareUrl = new URL(post.data.permalink, Astro.site).toString();
const shareText = post.data.title;
const xShare = `https://twitter.com/intent/tweet?text=${encodeURIComponent(
  shareText,
)}&url=${encodeURIComponent(shareUrl)}`;
const linkedInShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(
  shareUrl,
)}`;

const ogImage =
  post.data.heroImage ??
  `/og/${post.data.permalink.replace(/^\/+|\/+$/g, '').replace(/\//g, '-')}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  description,
  author: {
    '@type': 'Person',
    name: 'Tom Ron',
    url: 'https://tomron.net/about/',
  },
  publisher: { '@type': 'Person', name: 'Tom Ron' },
  mainEntityOfPage: shareUrl,
  url: shareUrl,
  image: new URL(ogImage, Astro.site).toString(),
  keywords: post.data.tags.map(decodeLabel).join(', '),
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  path={post.data.permalink}
  ogType="article"
  ogImage={ogImage}
  publishedTime={post.data.pubDate.toISOString()}
  tags={post.data.tags.map(decodeLabel)}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
    slot="head"
  />
  <article>
    {
      post.data.heroImage && (
        <img class="hero" src={post.data.heroImage} alt="" />
      )
    }
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{dateLong}</time>
        <span class="dot">·</span>
        <span>{minutes} min read</span>
        {
          post.data.tags.length > 0 && (
            <span class="tags">
              {post.data.tags.map((t) => (
                <a class="tag" href={`/tags/${tagSlug(t)}/`}>
                  {decodeLabel(t)}
                </a>
              ))}
            </span>
          )
        }
      </p>
    </header>

    <div class="post-body" set:html={bodyHtml} />

    <nav class="adjacent" aria-label="More posts">
      {
        newer ? (
          <a class="prev" href={newer.data.permalink}>
            <span class="dir">← Newer</span>
            <span class="t">{newer.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        older ? (
          <a class="next" href={older.data.permalink}>
            <span class="dir">Older →</span>
            <span class="t">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    {
      related.length > 0 && (
        <section class="related" aria-label="Related posts">
          <h2>Related posts</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={r.data.permalink}>{r.data.title}</a>
                <time datetime={r.data.pubDate.toISOString()}>
                  {r.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      mentions.length > 0 && (
        <section class="webmentions" aria-label="Webmentions">
          <h2>Mentions</h2>
          {reactions.length > 0 && (
            <ul class="reactions">
              {reactions.map((m) => (
                <li>
                  <a
                    href={m.url}
                    rel="noopener"
                    target="_blank"
                    title={`${m.author.name} — ${m.type}`}
                  >
                    {m.author.photo ? (
                      <img
                        src={m.author.photo}
                        alt={m.author.name}
                        width="32"
                        height="32"
                        loading="lazy"
                      />
                    ) : (
                      <span class="avatar-fallback">
                        {m.author.name.slice(0, 1)}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {responses.map((m) => (
            <article class="mention">
              <p class="mention-meta">
                {m.author.url ? (
                  <a href={m.author.url} rel="noopener" target="_blank">
                    {m.author.name}
                  </a>
                ) : (
                  <span>{m.author.name}</span>
                )}
                {m.published && (
                  <time datetime={m.published}>
                    {new Date(m.published).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </time>
                )}
              </p>
              {m.content && (
                <p class="mention-body">{m.content.slice(0, 500)}</p>
              )}
              <a
                class="mention-src"
                href={m.url}
                rel="noopener"
                target="_blank"
              >
                source →
              </a>
            </article>
          ))}
        </section>
      )
    }

    <footer class="post-footer">
      <a href="/blog/">← All posts</a>
      <div class="share">
        <span class="share-label">Share</span>
        <a
          href={xShare}
          target="_blank"
          rel="noopener"
          aria-label="Share on X"
          title="Share on X"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.22-6.82-5.97 6.82H1.66l7.73-8.83L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.01 4.13H5.05l12.03 15.64z"
            ></path>
          </svg>
        </a>
        <a
          href={linkedInShare}
          target="_blank"
          rel="noopener"
          aria-label="Share on LinkedIn"
          title="Share on LinkedIn"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"
            ></path>
          </svg>
        </a>
        <button
          type="button"
          class="copy-link"
          data-url={shareUrl}
          aria-label="Copy link"
          title="Copy link"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
            ></path>
          </svg>
          <span class="copied" hidden>Copied</span>
        </button>
      </div>
    </footer>
  </article>

  <script is:inline>
    document.querySelectorAll('.copy-link').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var url = btn.getAttribute('data-url');
        var done = function () {
          var tag = btn.querySelector('.copied');
          if (!tag) return;
          tag.hidden = false;
          setTimeout(function () {
            tag.hidden = true;
          }, 1500);
        };
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(done, done);
        } else {
          var t = document.createElement('textarea');
          t.value = url;
          document.body.appendChild(t);
          t.select();
          try {
            document.execCommand('copy');
          } catch (e) {}
          t.remove();
          done();
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .hero {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 1.5rem;
  }
  .post-header h1 {
    margin-bottom: 0.4rem;
    line-height: 1.25;
  }
  .meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
  }
  .meta .dot {
    opacity: 0.5;
  }
  .tag {
    background: var(--code-bg);
    color: var(--muted);
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.8rem;
  }
  .tag:hover {
    color: var(--fg);
    text-decoration: none;
  }
  .post-body {
    margin-top: 1.75rem;
  }
  .post-body :global(h2) {
    margin-top: 2rem;
  }
  .post-body :global(iframe) {
    max-width: 100%;
  }
  /* Shiki output: it emits --shiki-light / --shiki-dark on every token.
     We pick which set to honour based on the effective theme. */
  .post-body :global(pre.shiki) {
    background: var(--code-bg) !important;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.9rem;
  }
  .post-body :global(pre.shiki code) {
    background: none;
    padding: 0;
    display: block;
  }
  /* Light (default): use the light token colors. */
  .post-body :global(pre.shiki),
  .post-body :global(pre.shiki span) {
    color: var(--shiki-light);
    background-color: transparent;
  }
  /* OS dark and the user hasn't forced light -> dark token colors. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .post-body :global(pre.shiki),
    :global(:root:not([data-theme='light']))
      .post-body
      :global(pre.shiki span) {
      color: var(--shiki-dark);
    }
  }
  /* Explicit theme choices always win. */
  :global(:root[data-theme='dark']) .post-body :global(pre.shiki),
  :global(:root[data-theme='dark']) .post-body :global(pre.shiki span) {
    color: var(--shiki-dark);
  }
  :global(:root[data-theme='light']) .post-body :global(pre.shiki),
  :global(:root[data-theme='light']) .post-body :global(pre.shiki span) {
    color: var(--shiki-light);
  }

  .adjacent {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .adjacent a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    max-width: 48%;
  }
  .adjacent .next {
    text-align: right;
    margin-left: auto;
  }
  .adjacent .dir {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .adjacent .t {
    font-size: 0.95rem;
  }

  .related {
    margin-top: 2.5rem;
  }
  .related h2 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .related li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .related time {
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .webmentions {
    margin-top: 2.5rem;
  }
  .webmentions h2 {
    font-size: 1.15rem;
    margin-bottom: 0.6rem;
  }
  .reactions {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0 0 1rem;
  }
  .reactions img,
  .reactions .avatar-fallback {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--code-bg);
    color: var(--muted);
    font-weight: 600;
    object-fit: cover;
  }
  .mention {
    border-top: 1px solid var(--border);
    padding: 0.8rem 0;
  }
  .mention-meta {
    margin: 0;
    font-size: 0.9rem;
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }
  .mention-meta time {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .mention-body {
    margin: 0.35rem 0;
    font-size: 0.95rem;
  }
  .mention-src {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }
  .share {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .share-label {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .share a,
  .copy-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font: inherit;
  }
  .share a:hover,
  .copy-link:hover {
    color: var(--fg);
    text-decoration: none;
  }
  .copy-link .copied {
    color: var(--accent);
    font-size: 0.8rem;
  }
</style>
