---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, tagSlug } from '../lib/posts';

// WordPress tag labels can contain HTML entities like &#039; — decode for display.
const decodeLabel = (s: string) =>
  s
    .replace(/&#0*39;|&apos;|&#x0*27;/gi, '’')
    .replace(/&amp;/gi, '&')
    .replace(/&quot;/gi, '"');

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    // permalink is "/2014/05/12/slug/" -> slug param "2014/05/12/slug"
    params: { slug: post.data.permalink.replace(/^\/+|\/+$/g, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateLong = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// plain-text description from the body
const description =
  post.body
    ?.replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 160) || undefined;

const shareUrl = new URL(post.data.permalink, Astro.site).toString();
const shareText = post.data.title;
const xShare = `https://twitter.com/intent/tweet?text=${encodeURIComponent(
  shareText,
)}&url=${encodeURIComponent(shareUrl)}`;
const linkedInShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(
  shareUrl,
)}`;
---

<BaseLayout
  title={post.data.title}
  description={description}
  path={post.data.permalink}
  ogType="article"
  ogImage={post.data.heroImage}
>
  <article>
    {
      post.data.heroImage && (
        <img class="hero" src={post.data.heroImage} alt="" />
      )
    }
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{dateLong}</time>
        {
          post.data.tags.length > 0 && (
            <span class="tags">
              {post.data.tags.map((t) => (
                <a class="tag" href={`/tags/${tagSlug(t)}/`}>
                  {decodeLabel(t)}
                </a>
              ))}
            </span>
          )
        }
      </p>
    </header>

    <div class="post-body">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/blog/">← All posts</a>
      <div class="share">
        <span class="share-label">Share</span>
        <a
          href={xShare}
          target="_blank"
          rel="noopener"
          aria-label="Share on X"
          title="Share on X"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.22-6.82-5.97 6.82H1.66l7.73-8.83L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.01 4.13H5.05l12.03 15.64z"
            ></path>
          </svg>
        </a>
        <a
          href={linkedInShare}
          target="_blank"
          rel="noopener"
          aria-label="Share on LinkedIn"
          title="Share on LinkedIn"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"
            ></path>
          </svg>
        </a>
        <button
          type="button"
          class="copy-link"
          data-url={shareUrl}
          aria-label="Copy link"
          title="Copy link"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
            ></path>
          </svg>
          <span class="copied" hidden>Copied</span>
        </button>
      </div>
    </footer>
  </article>

  <script is:inline>
    document.querySelectorAll('.copy-link').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var url = btn.getAttribute('data-url');
        var done = function () {
          var tag = btn.querySelector('.copied');
          if (!tag) return;
          tag.hidden = false;
          setTimeout(function () {
            tag.hidden = true;
          }, 1500);
        };
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(done, done);
        } else {
          var t = document.createElement('textarea');
          t.value = url;
          document.body.appendChild(t);
          t.select();
          try {
            document.execCommand('copy');
          } catch (e) {}
          t.remove();
          done();
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .hero {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 1.5rem;
  }
  .post-header h1 {
    margin-bottom: 0.4rem;
    line-height: 1.25;
  }
  .meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
  }
  .tag {
    background: var(--code-bg);
    color: var(--muted);
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.8rem;
  }
  .tag:hover {
    color: var(--fg);
    text-decoration: none;
  }
  .post-body {
    margin-top: 1.75rem;
  }
  .post-body :global(h2) {
    margin-top: 2rem;
  }
  .post-body :global(iframe) {
    max-width: 100%;
  }
  .post-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }
  .share {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .share-label {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .share a,
  .copy-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font: inherit;
  }
  .share a:hover,
  .copy-link:hover {
    color: var(--fg);
    text-decoration: none;
  }
  .copy-link .copied {
    color: var(--accent);
    font-size: 0.8rem;
  }
</style>
