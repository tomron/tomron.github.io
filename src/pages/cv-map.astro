---
import BaseLayout from '../layouts/BaseLayout.astro';
import cv from '../data/cv-metro.json';

const roles = [...cv.stations].reverse();
const themes = cv.lines.filter((line) => !('planned' in line && line.planned));
const firstYear = cv.stations[0].period.match(/\d{4}/)?.[0] ?? '2012';
---

<BaseLayout
  title="Career atlas"
  description="Tom Ron's work across AI, engineering and leadership, from 2012 to today."
  path="/cv-map/"
>
  <div class="atlas">
    <header class="hero">
      <div class="hero-top">
        <span>THE CAREER ATLAS</span><span>TOM RON / 01</span>
      </div>
      <div class="hero-main">
        <div>
          <p class="overline">A career in motion / {firstYear} - now</p>
          <h1>Building what<br /><em>comes next.</em></h1>
          <p class="intro">
            From hands-on data science to leading teams that bring AI into
            everyday work. A visual record of the places, people and problems
            along the way.
          </p>
        </div>
        <div
          class="hero-index"
          aria-label={`${roles.length} workplaces since ${firstYear}`}
        >
          <span class="index-number"
            >{String(roles.length).padStart(2, '0')}</span
          >
          <span>WORKPLACES<br />SINCE {firstYear}</span>
        </div>
      </div>
      <div class="hero-foot">
        <span>SCROLL TO EXPLORE</span><span aria-hidden="true">↓</span>
      </div>
    </header>

    <div class="atlas-grid">
      <aside class="side" aria-label="Career index">
        <div class="side-inner">
          <span class="section-no">01 / THE THROUGHLINE</span>
          <h2>Three ways of working.</h2>
          <p>
            The labels show where each role sits. They are not proficiency
            scores.
          </p>
          <div class="key">
            {
              themes.map((theme, i) => (
                <div class="key-row">
                  <>
                    <span class="key-num">0{i + 1}</span>
                    <span class="key-line" style={`--theme:${theme.color}`} />
                    <strong>{theme.name}</strong>
                  </>
                </div>
              ))
            }
          </div>
          <p class="side-note">
            Select a workplace for the work behind the title. Hover on desktop,
            tap on mobile.
          </p>
          <a class="about-link" href="/about/"
            >Read the full CV <span aria-hidden="true">↗</span></a
          >
        </div>
      </aside>

      <main class="work" aria-label="Workplace timeline">
        <div class="work-head">
          <span class="section-no">02 / THE WORK</span><span
            >NEWEST → OLDEST</span
          >
        </div>
        <div class="timeline">
          {
            roles.map((role, i) => (
              <article class="role" data-role={role.id}>
                <div class="time">
                  <>
                    <span class="time-count">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="time-period">{role.period}</span>
                  </>
                </div>
                <div class="role-body">
                  <div class="role-heading">
                    <>
                      <div>
                        <>
                          <span class="role-location">{role.location}</span>
                          <h3>{role.name}</h3>
                          <p class="role-title">{role.role}</p>
                        </>
                      </div>
                      <button
                        class="role-toggle"
                        type="button"
                        data-station={role.id}
                        aria-label={`Show ${role.name} details`}
                        aria-expanded="false"
                        aria-controls={`detail-${role.id}`}
                      >
                        <span aria-hidden="true">+</span>
                      </button>
                    </>
                  </div>
                  <div class="marks" aria-label="Areas of work">
                    {themes.map((theme) => (
                      <span
                        class:list={[
                          'mark',
                          { inactive: !role.lines.includes(theme.id) },
                        ]}
                        style={`--theme:${theme.color}`}
                        title={theme.name}
                      >
                        <span class="mark-bar" />
                        {theme.name}
                      </span>
                    ))}
                  </div>
                  <div class="role-detail" id={`detail-${role.id}`} hidden>
                    <>
                      <p>{role.description}</p>
                      <ul>
                        {role.highlights.map((highlight) => (
                          <li>{highlight}</li>
                        ))}
                      </ul>
                    </>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </main>
    </div>

    <section class="lower" aria-label="More of the story">
      <div class="lower-heading">
        <span class="section-no">03 / THE REST OF THE PICTURE</span><h2>
          Beyond the job titles.
        </h2>
      </div>
      <div class="lower-grid">
        <div class="lower-card">
          <span class="lower-icon" aria-hidden="true">✳</span><span
            class="lower-number">01</span
          ><h3>Skills & practice</h3><p>
            Leadership, AI / data science and engineering are the three
            recurring threads across the roles above. Select a workplace to see
            the actual work behind each one.
          </p>
        </div>
        <div class="lower-card education-card">
          <span class="lower-icon" aria-hidden="true">◌</span>
          <span class="lower-number">02</span>
          <h3>Education</h3>
          <ul class="education-list">
            {
              cv.education.map((item) => (
                <li>
                  <>
                    <span>{item.period}</span>
                    <strong>{item.degree}</strong>
                    <span>{item.institution}</span>
                    <small>{item.detail}</small>
                  </>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="lower-card pending">
          <span class="lower-icon" aria-hidden="true">↗</span><span
            class="lower-number">03</span
          ><h3>Volunteering</h3><p>
            Space reserved for the work that happened outside the job titles.
          </p>
        </div>
      </div>
    </section>
    <footer class="atlas-footer">
      <span>TOM RON / CAREER ATLAS</span><a href="/about/">MORE ABOUT ME ↗</a
      ><span>END OF LINE? NOT QUITE.</span>
    </footer>
  </div>
  <script>
    const cards = [...document.querySelectorAll<HTMLElement>('.role')];
    let pinned: HTMLElement | null = null;
    const show = (card: HTMLElement) => {
      cards.forEach((item) => {
        const open = item === card;
        const panel = item.querySelector<HTMLElement>('.role-detail');
        const button = item.querySelector<HTMLButtonElement>('.role-toggle');
        if (panel) panel.hidden = !open;
        button?.setAttribute('aria-expanded', String(open));
        item.classList.toggle('is-open', open);
      });
    };
    const clear = () => {
      cards.forEach((item) => {
        const panel = item.querySelector<HTMLElement>('.role-detail');
        if (panel) panel.hidden = true;
        item
          .querySelector('.role-toggle')
          ?.setAttribute('aria-expanded', 'false');
        item.classList.remove('is-open');
      });
    };
    cards.forEach((card) => {
      card.addEventListener('mouseenter', () => {
        if (!pinned) show(card);
      });
      card.addEventListener('mouseleave', () => {
        if (!pinned) clear();
      });
      card.querySelector('.role-toggle')?.addEventListener('focus', () => {
        if (!pinned) show(card);
      });
      card.querySelector('.role-toggle')?.addEventListener('blur', () => {
        if (!pinned) clear();
      });
      card.querySelector('.role-toggle')?.addEventListener('click', () => {
        if (pinned === card) {
          pinned = null;
          clear();
        } else {
          pinned = card;
          show(card);
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .atlas {
    --ink: #162824;
    --paper: #f7f5ef;
    --line: #c9cec6;
    width: min(1320px, calc(100vw - 36px));
    margin: 1rem 50% 3rem;
    transform: translateX(-50%);
    color: var(--ink);
    background: var(--paper);
    font-family: var(--font);
    border: 1px solid #d5dad1;
  }
  .hero {
    min-height: 565px;
    background: #17352f;
    color: #f8f5e9;
    padding: 28px 42px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  .hero::after {
    content: '';
    position: absolute;
    right: -130px;
    bottom: -420px;
    width: 800px;
    height: 800px;
    border: 1px solid rgba(194, 230, 184, 0.17);
    border-radius: 50%;
    box-shadow:
      0 0 0 90px rgba(194, 230, 184, 0.035),
      0 0 0 190px rgba(194, 230, 184, 0.025);
    pointer-events: none;
  }
  .hero-top,
  .hero-foot,
  .work-head,
  .atlas-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font: 700 0.72rem var(--mono);
    letter-spacing: 0.12em;
  }
  .hero-top {
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
    padding-bottom: 19px;
  }
  .hero-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex: 1;
    gap: 30px;
    padding: 40px 0 55px;
    position: relative;
    z-index: 1;
  }
  .overline,
  .section-no,
  .role-location {
    font: 700 0.72rem var(--mono);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .overline {
    color: #bad8ae;
  }
  h1 {
    font-size: clamp(4rem, 9vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.083em;
    margin: 24px 0 26px;
    max-width: 1000px;
    font-weight: 800;
  }
  h1 em {
    color: #b9de96;
    font-style: normal;
  }
  .intro {
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    line-height: 1.5;
    max-width: 545px;
    margin: 0;
    color: #d7e4d7;
  }
  .hero-index {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 0 0 155px;
    border-top: 1px solid #a4cba0;
    padding-top: 7px;
    font: 700 0.75rem/1.6 var(--mono);
    color: #c5d9c2;
  }
  .index-number {
    font: 700 clamp(4.2rem, 7vw, 7rem)/1 var(--font);
    letter-spacing: -0.09em;
    color: #f8f5e9;
  }
  .hero-foot {
    border-top: 1px solid rgba(255, 255, 255, 0.28);
    padding-top: 17px;
    position: relative;
    z-index: 1;
  }
  .hero-foot span:last-child {
    font-size: 1.2rem;
  }
  .atlas-grid {
    display: grid;
    grid-template-columns: minmax(270px, 35%) 1fr;
  }
  .side {
    border-right: 1px solid var(--line);
    padding: 52px 42px;
  }
  .side-inner {
    position: sticky;
    top: 28px;
  }
  .section-no {
    color: #527665;
  }
  .side h2,
  .lower h2 {
    font-size: clamp(2.5rem, 4vw, 4.1rem);
    line-height: 1.03;
    letter-spacing: -0.06em;
    margin: 22px 0 14px;
  }
  .side p {
    max-width: 290px;
    line-height: 1.55;
    color: #51635a;
    font-size: 0.96rem;
  }
  .key {
    margin: 40px 0 35px;
    border-top: 1px solid var(--line);
  }
  .key-row {
    display: flex;
    align-items: center;
    gap: 13px;
    border-bottom: 1px solid var(--line);
    padding: 15px 0;
    font-size: 0.94rem;
  }
  .key-num {
    color: #71877a;
    font: 700 0.71rem var(--mono);
  }
  .key-line {
    width: 22px;
    height: 8px;
    background: var(--theme);
    border-radius: 8px;
  }
  .side .side-note {
    font-size: 0.82rem;
  }
  .about-link {
    display: inline-flex;
    gap: 30px;
    justify-content: space-between;
    min-width: 190px;
    border-bottom: 1px solid var(--ink);
    padding: 15px 0;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
  }
  .work {
    min-width: 0;
    padding: 45px 42px 70px;
  }
  .work-head {
    color: #536b5c;
    padding: 0 0 21px;
    border-bottom: 2px solid var(--ink);
  }
  .timeline {
    display: grid;
  }
  .role {
    display: grid;
    grid-template-columns: 115px minmax(0, 1fr);
    gap: 22px;
    padding: 30px 0 31px;
    border-bottom: 1px solid var(--line);
    transition: background 0.2s;
  }
  .role:hover,
  .role.is-open {
    background: #edf1e9;
  }
  .time {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .time-count {
    font: 700 clamp(2.8rem, 4vw, 4.5rem)/0.94 var(--font);
    letter-spacing: -0.075em;
    color: #aec0b3;
  }
  .time-period {
    font: 600 0.7rem/1.4 var(--mono);
    color: #54665c;
  }
  .role-heading {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 15px;
  }
  .role-location {
    color: #658271;
    font-size: 0.65rem;
  }
  .role h3 {
    font-size: clamp(2rem, 3.4vw, 3.5rem);
    letter-spacing: -0.065em;
    line-height: 1;
    margin: 7px 0 6px;
  }
  .role-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: #4c6357;
  }
  .role-toggle {
    background: transparent;
    border: 1px solid #7c9784;
    border-radius: 50%;
    color: var(--ink);
    width: 43px;
    height: 43px;
    flex: 0 0 43px;
    font-size: 1.7rem;
    cursor: pointer;
    line-height: 1;
    transition:
      transform 0.2s,
      background 0.2s;
  }
  .role-toggle:hover,
  .role-toggle:focus-visible {
    background: #d5e5cb;
    outline: 2px solid #426953;
    outline-offset: 2px;
  }
  .is-open .role-toggle span {
    display: inline-block;
    transform: rotate(45deg);
  }
  .marks {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    margin-top: 24px;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font: 700 0.62rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #496255;
  }
  .mark-bar {
    display: inline-block;
    width: 24px;
    height: 7px;
    background: var(--theme);
    border-radius: 5px;
  }
  .mark.inactive {
    opacity: 0.28;
  }
  .role-detail {
    margin: 24px 0 0;
    padding: 17px 20px;
    border-left: 3px solid #527665;
    background: #fffdf6;
    line-height: 1.5;
  }
  .role-detail[hidden] {
    display: none;
  }
  .role-detail p {
    margin: 0 0 8px;
  }
  .role-detail ul {
    padding-left: 19px;
    margin: 0;
  }
  .lower {
    background: #e8eee4;
    padding: 55px 42px 65px;
    border-top: 1px solid var(--line);
  }
  .lower-heading h2 {
    margin: 13px 0 32px;
  }
  .lower-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 2px solid var(--ink);
  }
  .lower-card {
    padding: 23px 27px 8px 0;
    min-height: 250px;
    position: relative;
  }
  .lower-card + .lower-card {
    border-left: 1px solid #bfccc0;
    padding-left: 27px;
  }
  .lower-number {
    display: block;
    font: 700 0.75rem var(--mono);
    color: #658271;
  }
  .lower-icon {
    position: absolute;
    right: 27px;
    top: 15px;
    font-size: 2rem;
    color: #5d9072;
  }
  .lower-card h3 {
    margin: 45px 0 8px;
    font-size: 1.55rem;
    letter-spacing: -0.04em;
  }
  .lower-card p {
    font-size: 0.9rem;
    line-height: 1.5;
    color: #52675b;
    max-width: 290px;
  }
  .education-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .education-list li {
    display: grid;
    gap: 2px;
    padding: 10px 0;
    border-top: 1px solid #c6d1c4;
  }
  .education-list li span:first-child {
    font: 700 0.65rem var(--mono);
    color: #5d806a;
  }
  .education-list li strong {
    font-size: 0.9rem;
  }
  .education-list li span:nth-of-type(2),
  .education-list li small {
    color: #52675b;
    font-size: 0.75rem;
    line-height: 1.3;
  }
  .lower-card.pending {
    opacity: 0.68;
  }
  .atlas-footer {
    padding: 20px 42px;
    background: #17352f;
    color: #e4f0dc;
    gap: 12px;
    flex-wrap: wrap;
  }
  .atlas-footer a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
  }
  @media (max-width: 800px) {
    .hero {
      min-height: 500px;
      padding: 21px 23px;
    }
    .hero-main {
      flex-direction: column;
      align-items: stretch;
      padding: 40px 0 30px;
    }
    .hero-index {
      flex: 0 0 auto;
      flex-direction: row;
      align-items: center;
      gap: 20px;
    }
    .atlas-grid {
      grid-template-columns: 1fr;
    }
    .side {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 35px 24px;
    }
    .side-inner {
      position: static;
    }
    .side h2 br {
      display: none;
    }
    .key {
      margin: 20px 0;
    }
    .key-row {
      padding: 10px 0;
    }
    .work {
      padding: 35px 24px 55px;
    }
    .lower {
      padding: 40px 24px;
    }
  }
  @media (max-width: 560px) {
    .atlas {
      width: calc(100vw - 16px);
      margin-top: 0.5rem;
    }
    .hero {
      min-height: 565px;
      padding: 18px;
    }
    .hero-top,
    .hero-foot {
      font-size: 0.6rem;
    }
    h1 {
      font-size: clamp(3.75rem, 15vw, 5.5rem);
      margin: 16px 0 20px;
    }
    .hero-main {
      justify-content: center;
      gap: 40px;
    }
    .intro {
      font-size: 1rem;
    }
    .hero-index {
      border-top: 1px solid #a4cba0;
    }
    .index-number {
      font-size: 4.5rem;
    }
    .side {
      padding: 31px 19px;
    }
    .side h2 {
      font-size: 2.65rem;
    }
    .work {
      padding: 30px 18px 48px;
    }
    .work-head {
      font-size: 0.59rem;
    }
    .role {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 11px;
      padding: 28px 0;
    }
    .time-count {
      font-size: 2.25rem;
    }
    .time-period {
      font-size: 0.54rem;
      overflow-wrap: anywhere;
    }
    .role h3 {
      font-size: clamp(1.8rem, 9vw, 2.55rem);
    }
    .role-title {
      font-size: 0.84rem;
    }
    .role-toggle {
      width: 35px;
      height: 35px;
      flex-basis: 35px;
      font-size: 1.3rem;
    }
    .marks {
      gap: 8px 12px;
      margin-top: 19px;
    }
    .mark {
      font-size: 0.53rem;
    }
    .mark-bar {
      width: 14px;
      height: 6px;
    }
    .role-detail {
      font-size: 0.87rem;
      padding: 12px;
    }
    .lower {
      padding: 39px 20px;
    }
    .lower-grid {
      grid-template-columns: 1fr;
    }
    .lower-card,
    .lower-card + .lower-card {
      border-left: 0;
      border-bottom: 1px solid #bfccc0;
      padding: 16px 0;
      min-height: unset;
    }
    .lower-card h3 {
      margin: 23px 0 8px;
    }
    .lower-icon {
      right: 0;
    }
    .atlas-footer {
      padding: 23px 18px;
      font-size: 0.58rem;
    }
  }
</style>
