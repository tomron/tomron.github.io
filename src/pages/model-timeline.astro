---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/model-releases.json';

interface Release {
  date: string;
  lab: string;
  model: string;
  note?: string;
  url: string;
  pricing?: string;
  benchmarks?: string;
  provisional?: boolean;
}

const labs = data.labs as { id: string; name: string; color: string }[];
const labById = new Map(labs.map((l) => [l.id, l]));
const releases = [...(data.releases as Release[])].sort((a, b) =>
  b.date.localeCompare(a.date),
);

const byYear = new Map<string, Release[]>();
for (const r of releases) {
  const year = r.date.slice(0, 4);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(r);
}

const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

const updated = fmtDate(data.updated);
---

<BaseLayout
  title="AI Model Release Timeline"
  description="Release dates, pricing and benchmarks of notable AI models from OpenAI, Google, Anthropic, Moonshot, Zhipu, DeepSeek, TypeSafe and Meta — on one timeline."
  path="/model-timeline/"
>
  <h1>AI Model Release Timeline</h1>
  <p>
    Release dates of notable models from {labs.length} labs, newest first. Dates and
    links point at official sources: API changelogs and announcements for the closed
    labs, Hugging Face uploads for the open-weight labs (the upload date is the public
    release date there).
  </p>
  <p class="meta-line">
    Last updated {updated} · {releases.length} entries · data refreshed daily by a{
      ' '
    }
    <a
      href="https://github.com/tomron/tomron.github.io/blob/main/.github/workflows/model-releases.yml"
      >GitHub Action</a
    > from official sources.
  </p>

  <div class="controls">
    <input
      id="q"
      type="search"
      placeholder="Search models…"
      autocomplete="off"
      aria-label="Search models"
    />
    <div class="chips" role="group" aria-label="Filter by lab">
      {
        labs.map((lab) => (
          <button
            type="button"
            class="chip"
            data-lab={lab.id}
            aria-pressed="true"
            style={`--lab-color: ${lab.color}`}
          >
            {lab.name}
          </button>
        ))
      }
    </div>
  </div>
  <p id="status" class="status" aria-live="polite"></p>

  <div id="timeline">
    {
      [...byYear.entries()].map(([year, items]) => (
        <section class="year" data-year={year}>
          <h2>{year}</h2>
          <ol class="entries">
            {items.map((r) => {
              const lab = labById.get(r.lab)!;
              return (
                <li
                  class="entry"
                  data-lab={r.lab}
                  data-search={`${r.model} ${lab.name}`.toLowerCase()}
                  style={`--lab-color: ${lab.color}`}
                >
                  <span class="dot" aria-hidden="true" />
                  <div class="entry-body">
                    <span class="date">{fmtDate(r.date)}</span>
                    <span class="model">
                      <a href={r.url}>{r.model}</a>
                      <span class="lab-tag">{lab.name}</span>
                      {r.provisional && (
                        <span class="provisional" title="Awaiting review">
                          provisional
                        </span>
                      )}
                    </span>
                    {r.note && <span class="note">{r.note}</span>}
                    {(r.pricing || r.benchmarks) && (
                      <span class="facts">
                        {r.pricing && <span>{r.pricing}</span>}
                        {r.benchmarks && <span>{r.benchmarks}</span>}
                      </span>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>

  <script is:inline>
    (function () {
      var input = document.getElementById('q');
      var status = document.getElementById('status');
      var chips = Array.prototype.slice.call(
        document.querySelectorAll('.chip'),
      );
      var entries = Array.prototype.slice.call(
        document.querySelectorAll('.entry'),
      );
      var years = Array.prototype.slice.call(
        document.querySelectorAll('.year'),
      );

      function apply() {
        var query = input.value.trim().toLowerCase();
        var active = {};
        chips.forEach(function (c) {
          if (c.getAttribute('aria-pressed') === 'true')
            active[c.getAttribute('data-lab')] = true;
        });
        var shown = 0;
        entries.forEach(function (e) {
          var ok =
            active[e.getAttribute('data-lab')] &&
            (!query || e.getAttribute('data-search').indexOf(query) !== -1);
          e.style.display = ok ? '' : 'none';
          if (ok) shown++;
        });
        years.forEach(function (y) {
          var any = Array.prototype.some.call(
            y.querySelectorAll('.entry'),
            function (e) {
              return e.style.display !== 'none';
            },
          );
          y.style.display = any ? '' : 'none';
        });
        status.textContent = shown
          ? 'Showing ' + shown + ' of ' + entries.length + ' releases'
          : 'No releases match';
      }

      chips.forEach(function (c) {
        c.addEventListener('click', function () {
          var on = c.getAttribute('aria-pressed') === 'true';
          c.setAttribute('aria-pressed', on ? 'false' : 'true');
          apply();
        });
      });
      input.addEventListener('input', apply);
    })();
  </script>

  <style>
    .meta-line {
      color: var(--muted);
      font-size: 0.9rem;
    }
    .controls {
      margin: 1.5rem 0 0.5rem;
    }
    #q {
      width: 100%;
      padding: 0.55rem 0.75rem;
      font-size: 1rem;
      font-family: var(--font);
      color: var(--fg);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 0.75rem;
    }
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .chip {
      font-family: var(--font);
      font-size: 0.8rem;
      padding: 0.25rem 0.7rem;
      border-radius: 999px;
      border: 1px solid var(--lab-color);
      background: var(--lab-color);
      color: #fff;
      cursor: pointer;
      opacity: 0.45;
      transition: opacity 0.15s;
    }
    .chip[aria-pressed='true'] {
      opacity: 1;
    }
    .status {
      color: var(--muted);
      font-size: 0.85rem;
      min-height: 1.4em;
    }
    .year h2 {
      margin: 1.75rem 0 0.5rem;
    }
    .entries {
      list-style: none;
      margin: 0;
      padding: 0;
      border-left: 2px solid var(--border);
    }
    .entry {
      position: relative;
      padding: 0.55rem 0 0.55rem 1.25rem;
    }
    .dot {
      position: absolute;
      left: -7px;
      top: 1.05rem;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--lab-color);
      border: 2px solid var(--bg);
    }
    .entry-body {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
    }
    .date {
      font-family: var(--mono);
      font-size: 0.8rem;
      color: var(--muted);
    }
    .model {
      font-weight: 600;
      line-height: 1.4;
    }
    .model a {
      color: var(--fg);
    }
    .model a:hover {
      color: var(--accent);
    }
    .lab-tag {
      font-weight: 400;
      font-size: 0.72rem;
      color: #fff;
      background: var(--lab-color);
      border-radius: 4px;
      padding: 0.1rem 0.4rem;
      margin-left: 0.5rem;
      vertical-align: 0.1em;
      white-space: nowrap;
    }
    .provisional {
      font-weight: 400;
      font-size: 0.72rem;
      color: var(--muted);
      border: 1px dashed var(--muted);
      border-radius: 4px;
      padding: 0.1rem 0.4rem;
      margin-left: 0.4rem;
      vertical-align: 0.1em;
      white-space: nowrap;
    }
    .note {
      color: var(--muted);
      font-size: 0.92rem;
    }
    .facts {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      font-size: 0.8rem;
      color: var(--muted);
      font-family: var(--mono);
    }
  </style>
</BaseLayout>
