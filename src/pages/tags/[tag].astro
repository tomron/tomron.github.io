---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagMap, postExcerpt, readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
  const tagMap = await getTagMap();
  return [...tagMap.entries()].map(([slug, { label, posts }]) => ({
    params: { tag: slug },
    props: { label, posts },
  }));
}

const { label, posts } = Astro.props;
const tag = Astro.params.tag;

const decodeLabel = (s: string) =>
  s
    .replace(/&#0*39;|&apos;|&#x0*27;/gi, '’')
    .replace(/&amp;/gi, '&')
    .replace(/&quot;/gi, '"');
const display = decodeLabel(label);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<BaseLayout
  title={`Posts tagged “${display}”`}
  description={`All posts by Tom Ron tagged ${display}.`}
  path={`/tags/${tag}/`}
>
  <p class="crumb"><a href="/tags/">Tags</a></p>
  <h1>#{display}</h1>
  <p class="count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <div class="row">
            <a class="title" href={post.data.permalink}>
              {post.data.title}
            </a>
            <span class="when">
              <time datetime={post.data.pubDate.toISOString()}>
                {fmt(post.data.pubDate)}
              </time>
              <span class="dot">·</span>
              {readingMinutes(post)} min
            </span>
          </div>
          <p class="excerpt">{postExcerpt(post, 180)}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .crumb {
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
  }
  h1 {
    margin: 0.25rem 0 0.25rem;
  }
  .count {
    color: var(--muted);
    margin-top: 0;
  }
  .post-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .post-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .post-list .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .post-list .title {
    font-weight: 500;
  }
  .post-list .when {
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .post-list .when .dot {
    opacity: 0.5;
    margin: 0 0.15rem;
  }
  .post-list .excerpt {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
</style>
